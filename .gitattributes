# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows batch files must keep CRLF — cmd.exe can misparse LF-only .bat
# files around labels/goto (e.g. android/gradlew.bat).
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
